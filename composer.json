{
  "name": "reservow/app",
  "type": "project",
  "description": "Gestão operacional de reservas e saídas em Porto de Galinhas",
  "require": {"php": "^8.3", "laravel/framework": "^12.0"},
  "require-dev": {"phpunit/phpunit": "^11.0", "mockery/mockery": "^1.6"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true}
}
